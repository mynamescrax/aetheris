{
	on_demand_tls {
		ask http://127.0.0.1:9999
	}
}

# on_demand_tls "ask" endpoint. MUST stay restrictive: returning 200 here
# tells Caddy (and therefore Let's Encrypt) that we're willing to mint a
# certificate for the requested domain. An unconditional 200 would let
# anyone who points DNS at this server get certs minted and the whole site
# (proxy included) served on their hostname. Only allow our own domains.
http://127.0.0.1:9999 {
	@allowed expression {http.request.uri.query.domain}.matches("(?i)^([a-z0-9-]+\\.)*(aetheris\\.win|crax\\.lol)$")
	respond @allowed 200
	respond 404
}

# tls_insecure_skip_verify is deliberate: some of these game CDNs serve
# certificates that don't match the SNI we connect with. It means the
# server→upstream leg isn't authenticated — acceptable for game/movie
# traffic, but don't copy this pattern for anything sensitive.
(region_proxy) {
	handle_path {args[0]}/* {
		reverse_proxy {args[1]}:443 {
			header_up Host {args[1]}
			header_up Origin https://{args[2]}
			header_up Referer https://{args[2]}/
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}
}
(files_proxy) {
	handle_path {args[0]}/* {
		reverse_proxy {args[1]}:443 {
			header_up Host {args[1]}
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}
}
(root_proxy) {
	handle_path {args[0]}/* {
		reverse_proxy {args[1]}:443 {
			header_up Host {args[1]}
			header_up X-Real-IP {remote_host}
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}
}
(movie_proxy) {
	handle_path {args[0]}/* {
		reverse_proxy {args[1]}:443 {
			header_up Host {args[1]}
			header_up Origin https://{args[1]}
			header_up Referer https://{args[1]}/
			header_down -X-Frame-Options
			header_down -Content-Security-Policy
			header_down -Content-Security-Policy-Report-Only
			header_down -Cross-Origin-Embedder-Policy
			header_down -Cross-Origin-Opener-Policy
			header_down -Cross-Origin-Resource-Policy
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}
}
(veck_init) {
	handle_path /proxy/{args[0]}/api/init {
		header Content-Type application/json
		respond `{"region":"{args[1]}"}` 200
	}
}
(veck_join) {
	@join_{args[0]} path_regexp join_{args[0]} "^/proxy/{args[1]}/matchmake/joinById/(.+)$"
	handle @join_{args[0]} {
		rewrite * /api/coly-matchmaker/join-by-id/{re.join_{args[0]}.1}
		reverse_proxy {args[2]}:443 {
			header_up Host {args[2]}
			header_up Origin https://aetheris.win
			header_up Referer https://aetheris.win/
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}
}

https:// {
	tls {
		on_demand
	}

	# compress text on the wire. the games catalog alone is ~5.5MB of JSON
	# (~1.1MB gzipped) and the proxy/game JS bundles shrink just as much —
	# without this every cold visit pays the full uncompressed weight.
	encode zstd gzip

	# CORS Preflight
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD"
		header Access-Control-Allow-Headers "Content-Type, Authorization, Origin, Accept, X-Requested-With"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	# crax.lol profile site
	@crax host crax.lol
	handle @crax {
		handle /api/* {
			reverse_proxy http://127.0.0.1:3001
		}
		handle {
			root * /var/www/profile
			header Cache-Control "no-store"
			file_server
		}
	}

	# hosting.crax.lol file server
	@hosting host hosting.crax.lol
	handle @hosting {
		root * /var/www/hosting
		file_server browse
	}

	# gpt.crax.lol — crax-gpt (OpenAI-compatible proxy + chat UI)
	@craxgpt host gpt.crax.lol
	handle @craxgpt {
		reverse_proxy http://127.0.0.1:3002
	}

	# WebSocket proxy
	@wsproxy path_regexp wsproxy ^/(wsproxy|tsunamis/wsproxy)/(([^/]+\.)?(veck\.io|growden\.io|tsunamis\.io|stealnow\.io|luckyblocks\.io|2v2\.io))(/.*)$
	handle @wsproxy {
		rewrite * {re.wsproxy.5}
		reverse_proxy {re.wsproxy.2}:443 {
			header_up Host {re.wsproxy.2}
			header_up Origin https://{re.wsproxy.4}
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}

	# 1games.io API
	handle_path /api-proxy/* {
		reverse_proxy api.1games.io:443 {
			header_up Host api.1games.io
			header_up Origin https://dashmetry.1games.io
			header_up Referer https://dashmetry.1games.io/
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}

