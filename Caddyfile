	# GitHub-hosted game builds. Stream the raw files through our own
	# origin instead so browsers also avoid cross-origin restrictions.
	@game_javascript path_regexp game_javascript ^/game-assets/.*\.js$
	header @game_javascript >Content-Type "application/javascript; charset=utf-8"

	@game_stylesheet path_regexp game_stylesheet ^/game-assets/.*\.css$
	header @game_stylesheet >Content-Type "text/css; charset=utf-8"

	handle_path /game-assets/1games-rips/* {
		rewrite * /mynamescrax/1games-rips/main{path}
		reverse_proxy raw.githubusercontent.com:443 {
			header_up Host raw.githubusercontent.com
			header_down -Content-Disposition
			header_down -X-Content-Type-Options
			transport http {
				tls
			}
		}
	}

	handle_path /game-assets/gamesforaetheris/* {
		rewrite * /mynamescrax/gamesforaetheris/main{path}
		reverse_proxy raw.githubusercontent.com:443 {
			header_up Host raw.githubusercontent.com
			header_down -Content-Disposition
			header_down -X-Content-Type-Options
			transport http {
				tls
			}
		}
	}

	handle_path /game-assets/ultrapool/* {
