# --- index.js ---
# Discord webhook that receives bug reports from the in-site report modals
REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Discord webhook that receives the site stats summary (every 5 minutes,
# including the top 5 countries of people online, resolved via ip-api.com)
STATS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Port the app listens on (Caddy proxies to this). Default: 8080
#PORT=8080
# Optional listen interface. Keep the existing default (::), or use loopback
# when only a same-machine Caddy should reach Node.
#HOST=127.0.0.1
# OFF by default: do not terminate another healthy instance on port conflicts.
#RECOVER_DUPLICATE_INSTANCE=true
# Online-counter SSE caps. Every stream holds a socket, so both are bounded.
# Per-IP default is generous because a whole school can share one NAT address.
#MAX_SSE_CLIENTS=2000
#MAX_SSE_PER_IP=128
# Extra hostnames (comma-separated) allowed to open the /wisp/ WebSocket, on
# top of same-origin and our own domains. LC_RELAY_EXTRA_ORIGINS is the older
# name and still works.
#WS_EXTRA_ORIGINS=truffled.lol,example.com

# --- AI (crax-gpt / OpenAI-compatible proxy) ---
# API key for https://gpt.crax.lol - generate one under Settings > API keys in
# crax-gpt. Server-side only; never put it in client code.
CRAX_GPT_KEY=sk-xxxxx
# OpenAI-compatible base URL (defaults to https://gpt.crax.lol/v1)
#CRAX_GPT_BASE_URL=https://gpt.crax.lol/v1
# Default chat model (defaults to gpt-5-6-sol)
#CRAX_GPT_MODEL=gpt-5-6-sol
# Default image model (defaults to gpt-image-2)
#CRAX_GPT_IMAGE_MODEL=gpt-image-2
# Restrict AI requests to signed-in site accounts. Recommended for public sites.
# Client uses the existing DM login; no API key is exposed.
#AI_REQUIRE_LOGIN=true

# --- Movies (TMDB) ---
# Required for movie/TV search and listings. TMDB calls go through the
# server-side /api/tmdb passthrough so the key never ships in client code.
# Without it /api/tmdb/* returns 503 "Movies search not configured".
# Get a v3 API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Upstream base (defaults to https://api.themoviedb.org/3)
#TMDB_BASE_URL=https://api.themoviedb.org/3

# --- monitor.js ---
# Discord webhook for uptime alerts (required - monitor exits without it)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Comma-separated list of sites to check
#DOMAINS=https://aetheris.win,https://crax.lol,https://hosting.crax.lol
# Where the app listens, used to decide whether a failure is Caddy or the app
#FALLBACK_HOST=127.0.0.1
#FALLBACK_PORT=8080
# Seconds between checks (default 60)
#CHECK_INTERVAL=60
# Per-check HTTP timeout in seconds (default 8)
#TIMEOUT=8
# pm2 process name of the app (default aetheris)
#APP_SERVICE=aetheris
# Log file (default /var/log/monitor.log)
#LOG_FILE=/var/log/monitor.log
# Minutes between Discord summary reports (default 15)
#REPORT_INTERVAL=15
# Application directory the monitor checks/recovers (default: monitor.js's dir)
#APP_DIR=/var/www/aetheris
# .env file used when restarting the app in recovery (default <APP_DIR>/.env)
#ENV_FILE=/var/www/aetheris/.env
# Minimum seconds between automatic recovery actions (default 300)
#RECOVERY_COOLDOWN=300
