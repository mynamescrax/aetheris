{
  "name": "aetheris",
  "version": "1.1.0",
  "private": true,
  "description": "games, proxy, movies and chat in one site",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "node index.js",
    "format": "prettier --write .",
    "lint": "eslint index.js monitor.js lc-relay.js movie-relay.js lib/ scripts/ tests/ public/",
    "lint:fix": "eslint index.js monitor.js lc-relay.js movie-relay.js lib/ scripts/ tests/ public/ --fix",
    "check": "node scripts/check-source.js",
    "stamp": "node scripts/stamp-assets.js",
    "test": "node --test tests/*.test.js"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "fastify": "^5.12.8",
    "wispurr": "4.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "brace-expansion@^5.0.0": "^5.0.12",
      "fast-uri@^3.0.1": "3.1.9",
      "fast-uri@^4.0.0": "4.2.3",
      "minimatch@^10.0.0": "11.0.5"
    }
  }
}
